{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test All Targets (C++ Core, Painter & Web Parity)",
            "type": "shell",
            "command": "make test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Desktop Simulator (zd_sim --demo)",
            "type": "shell",
            "command": "make demo",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Serve Web Port (localhost:8080)",
            "type": "shell",
            "command": "make web-serve",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "PlatformIO: Build (M5StickC / Plus)",
            "type": "shell",
            "command": "pio run -e m5stick-c",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Build (M5StickC Plus2)",
            "type": "shell",
            "command": "pio run -e m5stick-c-plus2",
            "group": "build",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Build (M5Stack Core2)",
            "type": "shell",
            "command": "pio run -e m5stack-core2",
            "group": "build",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Upload (M5StickC / Plus)",
            "type": "shell",
            "command": "pio run -e m5stick-c --target upload",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Upload (M5StickC Plus2)",
            "type": "shell",
            "command": "pio run -e m5stick-c-plus2 --target upload",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Serial Monitor",
            "type": "shell",
            "command": "pio device monitor -b 115200",
            "problemMatcher": []
        }
    ]
}
