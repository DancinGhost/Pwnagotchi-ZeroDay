{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test Functional Core (Host g++)",
            "type": "shell",
            "command": "mkdir -p build && g++ -std=c++17 -Wall -Wextra -Werror -Iinclude test/test_functional_core.cpp -o build/test_functional_core && ./build/test_functional_core",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "PlatformIO: Build (M5StickC / Plus)",
            "type": "shell",
            "command": "pio run -e m5stick-c",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Build (M5StickC Plus2)",
            "type": "shell",
            "command": "pio run -e m5stick-c-plus2",
            "group": "build",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Upload (M5StickC / Plus)",
            "type": "shell",
            "command": "pio run -e m5stick-c --target upload",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Upload (M5StickC Plus2)",
            "type": "shell",
            "command": "pio run -e m5stick-c-plus2 --target upload",
            "problemMatcher": [
                "$platformio"
            ]
        },
        {
            "label": "PlatformIO: Serial Monitor",
            "type": "shell",
            "command": "pio device monitor -b 115200",
            "problemMatcher": []
        }
    ]
}
